# Entorno local — copia a apps/web/.env y completa con tu proyecto Supabase
# Dashboard: https://supabase.com/dashboard → Project Settings → API

# Públicas (expuestas al navegador; protege tablas con RLS)
VITE_SUPABASE_URL=https://TU_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=tu_anon_key

# Mismas claves para el servidor (SSR / server functions)
SUPABASE_URL=https://TU_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=tu_anon_key

# Solo servidor — NUNCA la subas a Git ni la uses en el cliente
SUPABASE_SERVICE_ROLE_KEY=tu_service_role_key

# Opcional: Postgres directo (Settings → Database → Connection string)
# Usa el pooler (Transaction) desde Render si está fuera de la red de Supabase
# DATABASE_URL=postgresql://postgres.TU_REF:PASSWORD@aws-0-us-east-1.pooler.supabase.com:6543/postgres
